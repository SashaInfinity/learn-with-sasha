# ===========================================================================
# Learn With Sasha — backend environment
# Copy this file to .env and fill in real values. NEVER commit .env.
#
# The .env loaded by `dotenv` (see src/lib/config.ts) is the single source of
# truth at runtime. Keep separate values for local dev vs production:
# ===========================================================================

# --- Server ---
PORT=3002
NODE_ENV=development
# Comma-separated list of allowed browser origins for CORS.
# Local dev: the Vite dev server. Production: the origin that serves the
# frontend, e.g. https://learn.sashainfinity.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Postgres (the shared sasha_lms `tutor_lms` database) ---
# Local dev can point at the docker postgres via the published port. NOTE: the
# live sasha_lms stack does NOT publish 5432 to the host, so either (a) publish
# it in docker-compose, or (b) run this backend inside the sasha_lms_tutor-
# network and use host `postgres`.
DATABASE_URL=postgresql://tutor:SashaInfinite2024@127.0.0.1:5432/tutor_lms

# --- Auth proxy target (the LMS FastAPI backend) ---
# learn-with-sasha proxies login here and validates sessions via /auth/me.
#
# LOCAL DEV (login works without running FastAPI yourself): point at the remote
# LMS API. This is the default in config.ts if AUTH_BACKEND_URL is unset.
AUTH_BACKEND_URL=https://backend.sashainfinity.com/api/v1
# To develop against a locally-running LMS instead, use:
# AUTH_BACKEND_URL=http://127.0.0.1:8000/api/v1

# Cookie name holding the JWT.
AUTH_COOKIE_NAME=learn_sasha_token
# Cookie domain. OMIT (or leave blank) in local dev so the cookie takes the
# request host (localhost) — setting COOKIE_DOMAIN=localhost with a 127.0.0.1
# request gets the cookie rejected. Pin it to your real domain only in prod.
# COOKIE_DOMAIN=
# Production example:
# COOKIE_DOMAIN=learn.sashainfinity.com

# --- Gemini (server-side ONLY; never reaches the browser) ---
GEMINI_API_KEY=your_new_rotated_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Local Piper TTS (loopback only; OpenAI-compatible /v1/audio/speech) ---
TTS_URL=http://127.0.0.1:5000
PIPER_VOICE=en_US-lessac-high
