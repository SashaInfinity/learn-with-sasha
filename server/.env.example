# ===========================================================================
# Learn With Sasha — backend environment
# Copy this file to .env and fill in real values. NEVER commit .env.
# ===========================================================================

# --- Server ---
PORT=3002
NODE_ENV=development
# Comma-separated list of allowed browser origins for CORS.
# In production: the origin that serves the frontend, e.g. https://learn.sashainfinity.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Postgres (the shared sasha_lms `tutor_lms` database) ---
# When running standalone on the host, point at the docker postgres via the
# published port. NOTE: the live sasha_lms stack does NOT publish 5432 to the
# host, so either (a) publish it in docker-compose, or (b) run this backend
# inside the sasha_lms_tutor-network and use host `postgres`.
DATABASE_URL=postgresql://tutor:SashaInfinite2024@127.0.0.1:5432/tutor_lms

# --- Auth proxy target (the existing FastAPI backend) ---
# learn-with-sasha proxies login here and validates sessions via /auth/me.
AUTH_BACKEND_URL=http://127.0.0.1:8000/api/v1
# Cookie name holding the JWT.
AUTH_COOKIE_NAME=learn_sasha_token
# Set this to your real frontend domain in production.
COOKIE_DOMAIN=localhost

# --- Gemini (server-side ONLY; never reaches the browser) ---
GEMINI_API_KEY=your_new_rotated_key_here
GEMINI_MODEL=gemini-2.5-flash
